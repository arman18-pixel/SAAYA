}  
  
.view{display:none}  
.view.active{display:block}  
  
.card{  
  background:linear-gradient(180deg,#171020,#100b17);  
  border:1px solid var(--line);  
  border-radius:22px;  
  padding:16px;  
  margin:12px 0;  
  box-shadow:0 12px 30px #0005  
}  
  
.hero{  
  padding:20px;  
  border-radius:25px;  
  background:  
    radial-gradient(circle at 80% 10%,#5d2da455,transparent 45%),  
    linear-gradient(145deg,#1d1129,#0d0912);  
  border:1px solid #3b2850  
}  
  
.kicker{  
  font-size:11px;  
  text-transform:uppercase;  
  letter-spacing:1.8px;  
  color:#b99bff  
}  
  
.hero h1{  
  font-size:29px;  
  margin:7px 0  
}  
  
.hero p{  
  color:#c3b9ca;  
  font-size:13px;  
  line-height:1.5;  
  margin:0  
}  
  
.pill{  
  display:inline-flex;  
  align-items:center;  
  gap:6px;  
  padding:7px 10px;  
  border-radius:999px;  
  font-size:11px;  
  background:#1f1729;  
  border:1px solid #3b2b4c;  
  color:#ddd  
}  
  
.dot{  
  width:7px;  
  height:7px;  
  border-radius:50%;  
  background:var(--green);  
  box-shadow:0 0 10px var(--green)  
}  
  
.btn{  
  width:100%;  
  border:0;  
  border-radius:17px;  
  padding:15px;  
  font-weight:800;  
  color:white;  
  background:linear-gradient(135deg,#7c3aed,#b45cff);  
  font-size:14px;  
  box-shadow:0 10px 25px #7c3aed35;  
  cursor:pointer  
}  
  
.btn.secondary{  
  background:#1b1324;  
  border:1px solid #39294a;  
  box-shadow:none  
}  
  
.btn.danger{  
  background:linear-gradient(135deg,#d92e55,#ff5b78)  
}  
  
.grid{  
  display:grid;  
  grid-template-columns:1fr 1fr;  
  gap:10px  
}  
  
.metric{  
  padding:14px;  
  border-radius:18px;  
  background:#130e1b;  
  border:1px solid var(--line)  
}  
  
.metric small{color:var(--muted)}  
  
.metric b{  
  display:block;  
  margin-top:7px;  
  font-size:18px  
}  
  
.row{  
  display:flex;  
  justify-content:space-between;  
  gap:12px;  
  align-items:center  
}  
  
.title{font-weight:800}  
  
.muted{  
  color:var(--muted);  
  font-size:12px  
}  
  
.tag{  
  padding:6px 8px;  
  border-radius:9px;  
  font-size:10px;  
  background:#251b31;  
  color:#d5c8df  
}  
  
.step{  
  display:flex;  
  gap:12px;  
  margin:14px 0  
}  
  
.num{  
  width:28px;  
  height:28px;  
  border-radius:50%;  
  display:grid;  
  place-items:center;  
  background:#27173a;  
  color:#d8baff;  
  font-weight:800;  
  font-size:12px;  
  flex:none  
}  
  
.step.done .num{  
  background:#17382c;  
  color:var(--green)  
}  
  
.step.active .num{  
  background:#3b1c50;  
  color:#fff  
}  
  
.progress{  
  height:8px;  
  background:#241b2d;  
  border-radius:99px;  
  overflow:hidden;  
  margin:10px 0  
}  
  
.bar{  
  height:100%;  
  width:0;  
  background:linear-gradient(90deg,#7c3aed,#d08aff);  
  transition:width .8s  
}  
  
.scoreWrap{  
  display:flex;  
  align-items:center;  
  gap:16px  
}  
  
.ring{  
  width:88px;  
  height:88px;  
  border-radius:50%;  
  display:grid;  
  place-items:center;  
  background:conic-gradient(  
    #b45cff 0deg,  
    #7c3aed 0deg,  
    #251b2d 0deg  
