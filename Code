}  
  
.appbar{  
  padding:12px 18px 10px;  
  display:flex;  
  align-items:center;  
  gap:12px  
}  
  
.brand b{  
  font-size:20px;  
  letter-spacing:1.8px  
}  
  
.brand span{  
