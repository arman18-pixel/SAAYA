}  
  
.ring:after{  
  content:"";  
  position:absolute;  
  inset:8px;  
  border-radius:50%;  
  background:#100b17  
}  
  
.ring span{  
  position:relative;  
  z-index:2;  
  font-size:20px;  
  font-weight:900  
}  
  
.check{  
  color:var(--green);  
  font-weight:800  
}  
  
.warn{  
  color:var(--amber);  
  font-weight:800  
}  
  
.bad{  
  color:var(--red);  
  font-weight:800  
}  
  
.bottom{  
  position:fixed;  
  bottom:0;  
  left:50%;  
  transform:translateX(-50%);  
  width:min(430px,100%);  
  height:76px;  
  background:#0c0811ee;  
