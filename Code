  font-size:20px;  
  margin-bottom:4px;  
  font-style:normal  
}  
  
.modal{  
  position:fixed;  
  inset:0;  
  background:#0009;  
  display:none;  
  align-items:flex-end;  
  z-index:30  
}  
  
.modal.show{display:flex}  
  
.sheet{  
  width:min(430px,100%);  
  margin:auto;  
  background:#120c19;  
  border:1px solid #3a2a49;  
  border-radius:28px 28px 0 0;  
  padding:22px 18px 30px;  
  animation:up .25s ease  
}  
  
@keyframes up{  
  from{transform:translateY(100%)}  
  to{transform:translateY(0)}  
}  
  
.pulse{  
  width:96px;  
  height:96px;  
  border-radius:50%;  
  margin:8px auto 18px;  
  display:grid;  
  place-items:center;  
  background:#3b1630;  
